# ==========================================
# TeamFlow - Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Inside Docker Compose: postgres:5432
# Local dev on host: localhost:5432
DATABASE_URL=postgresql://teamflow:teamflow_password@localhost:5432/teamflow?schema=public

# Database credentials for Docker Compose
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=teamflow_password
POSTGRES_DB=teamflow
POSTGRES_PORT=5432

# Redis (Cache, Rate Limiting, BullMQ)
# Inside Docker Compose: redis:6379
# Local dev on host: localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Object Storage (S3-Compatible)
# Browser accessible endpoint: http://localhost:9000
# S3 API endpoint inside Docker: http://minio:9000
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=teamflow-attachments
MINIO_CONSOLE_PORT=9001

# Security & Authentication
JWT_ACCESS_SECRET=super_secret_teamflow_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_teamflow_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=teamflow_secure_cookie_secret_key_12345
